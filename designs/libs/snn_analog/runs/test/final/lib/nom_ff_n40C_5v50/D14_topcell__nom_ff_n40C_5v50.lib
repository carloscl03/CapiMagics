library (D14_topcell) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : -40.0;
  nom_voltage                    : 5.50;


  cell ("D14_topcell") {
    is_macro_cell : true;
    pin("Vin") {
      direction : input;
      capacitance : 0.0033;
    }
    pin("Vin_neg") {
      direction : input;
      capacitance : 0.0059;
    }
    pin("nvout_1") {
      direction : output;
      capacitance : 0.0112;
    }
    pin("nvout_2") {
      direction : output;
      capacitance : 0.0557;
    }
    pin("nvout_3") {
      direction : output;
      capacitance : 0.0525;
    }
    pin("nvout_4") {
      direction : output;
      capacitance : 0.0177;
    }
    pin("vout_1") {
      direction : output;
      capacitance : 0.0041;
    }
    pin("vout_2") {
      direction : output;
      capacitance : 0.0238;
    }
    pin("vout_3") {
      direction : output;
      capacitance : 0.0596;
    }
    pin("vout_4") {
      direction : output;
      capacitance : 0.0369;
    }
  }

}
