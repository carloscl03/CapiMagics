M12 n5 vpost vdep avss nfet_03v3 L=0.63u W=0.5u nf=1
M17 vpot vb_itp avdd avdd pfet_03v3 L=4.6u W=0.5u nf=1
MCM_1 n4 vb_pot avss avss nfet_03v3 L=2.8u W=0.61u nf=1
M16 n5 vb_idep avdd avdd pfet_03v3 L=2.8u W=10.2u nf=1
MCM_5 vdep vb_itd n6 avss nfet_03v3 L=10u W=0.5u nf=1
MCM_6 n6 vb_itd n7 avss nfet_03v3 L=10u W=0.5u nf=1
MCM_7 n7 vb_itd n8 avss nfet_03v3 L=10u W=0.5u nf=1
MCM_8 n8 vb_itd n9 avss nfet_03v3 L=10u W=0.5u nf=1
MCM_9 n9 vb_itd avss avss nfet_03v3 L=10u W=0.5u nf=1
x1[0] vdep avss unitcap
x1[1] vdep avss unitcap
x2[0] vw avss unitcap
x2[1] vw avss unitcap
