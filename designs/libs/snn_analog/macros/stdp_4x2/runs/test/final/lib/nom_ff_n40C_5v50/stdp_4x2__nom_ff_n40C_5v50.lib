library (stdp_4x2) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : -40.0;
  nom_voltage                    : 5.50;


  cell ("stdp_4x2") {
    is_macro_cell : true;
    pin("A") {
      direction : inout;
      capacitance : 0.1324;
    }
    pin("B") {
      direction : inout;
      capacitance : 0.1372;
    }
    pin("ifwd1") {
      direction : output;
      capacitance : 0.0136;
    }
    pin("ifwd2") {
      direction : output;
      capacitance : 0.0101;
    }
    pin("nvpost1") {
      direction : input;
      capacitance : 0.0461;
    }
    pin("nvpost2") {
      direction : input;
      capacitance : 0.0426;
    }
    pin("nvpre1") {
      direction : input;
      capacitance : 0.0180;
    }
    pin("nvpre2") {
      direction : input;
      capacitance : 0.0127;
    }
    pin("nvpre3") {
      direction : input;
      capacitance : 0.0125;
    }
    pin("nvpre4") {
      direction : input;
      capacitance : 0.0163;
    }
    pin("vpost1") {
      direction : input;
      capacitance : 0.0194;
    }
    pin("vpost2") {
      direction : input;
      capacitance : 0.0213;
    }
    pin("vpre1") {
      direction : input;
      capacitance : 0.0161;
    }
    pin("vpre2") {
      direction : input;
      capacitance : 0.0130;
    }
    pin("vpre3") {
      direction : input;
      capacitance : 0.0144;
    }
    pin("vpre4") {
      direction : input;
      capacitance : 0.0143;
    }
    pin("vw11") {
      direction : inout;
      capacitance : 0.0751;
    }
    pin("vw42") {
      direction : inout;
      capacitance : 0.0827;
    }
  }

}
