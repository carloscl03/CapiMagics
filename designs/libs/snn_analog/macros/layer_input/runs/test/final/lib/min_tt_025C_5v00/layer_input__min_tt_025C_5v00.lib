library (layer_input) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 25.0;
  nom_voltage                    : 5.00;


  cell ("layer_input") {
    area : 6663.200 
    is_macro_cell : true;
    pin("Iext1") {
      direction : input;
      capacitance : 0.0028;
    }
    pin("Iext2") {
      direction : input;
      capacitance : 0.0028;
    }
    pin("Iext3") {
      direction : input;
      capacitance : 0.0028;
    }
    pin("Iext4") {
      direction : input;
      capacitance : 0.0027;
    }
    pin("nvout_1") {
      direction : output;
      capacitance : 0.0077;
    }
    pin("nvout_2") {
      direction : output;
      capacitance : 0.0057;
    }
    pin("nvout_3") {
      direction : output;
      capacitance : 0.0042;
    }
    pin("nvout_4") {
      direction : output;
      capacitance : 0.0080;
    }
    pin("vout_1") {
      direction : output;
      capacitance : 0.0045;
    }
    pin("vout_2") {
      direction : output;
      capacitance : 0.0047;
    }
    pin("vout_3") {
      direction : output;
      capacitance : 0.0048;
    }
    pin("vout_4") {
      direction : output;
      capacitance : 0.0049;
    }
  }

}
